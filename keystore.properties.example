# Copy to keystore.properties (gitignored - NEVER commit it) to sign release builds.
# Without keystore.properties, assembleRelease produces an UNSIGNED app-release-unsigned.apk.
# If this file exists but is incomplete or storeFile doesn't exist, the release build fails
# (verifyReleaseConfig) instead of silently producing an unsigned APK.
#
# storeFile: absolute path, or relative to the project root. On Windows use forward slashes
# (C:/Users/me/keys/spotter-upload.jks) or escaped backslashes (C:\\Users\\...).
# To keep publishing over the existing Play listing (same applicationId as the RN app), use the
# upload key the RN/EAS build used (eas credentials -> Android -> download keystore).
storeFile=
storePassword=
keyAlias=
keyPassword=
